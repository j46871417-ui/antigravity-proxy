PROXY_HOST=0.0.0.0
PROXY_PORT=50128
PROXY_USER=antigravity
PROXY_PASS=replace-with-a-long-random-password
PROXY_PUBLIC_HOST=proxy.example.com
USERS_FILE=/opt/antigravity-proxy/users.json
USER_TRAFFIC_FILE=/opt/antigravity-proxy/user_traffic.json
