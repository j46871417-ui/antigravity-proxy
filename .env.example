PROXY_USER=ag_user
PROXY_PASS=replace-with-a-long-random-password
PROXY_LISTEN_HOST=127.0.0.1
PROXY_LISTEN_PORT=50127
LOG_LEVEL=INFO
# strict = only ALLOWED_EXACT_HOSTS/ALLOWED_DOMAIN_SUFFIXES
# direct = public domains on ALLOWED_PORTS go directly from this VPS
PROXY_BYPASS_MODE=strict
BUFFER_SIZE=65536
# USER_MONTHLY_SOFT_LIMIT_BYTES=32212254720 # Default: 30 GB per month soft limit
# USER_TRAFFIC_FILE=/opt/antigravity-proxy/user_traffic.json
